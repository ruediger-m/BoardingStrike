<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-local NuGet configuration.

  Committed so that `dotnet restore` is reproducible on any machine and on CI,
  independent of a contributor's user/machine-level NuGet config (which may pin
  package source mapping to an offline-only feed and otherwise block nuget.org).

  We <clear/> inherited sources and define a single portable source so the build
  behaves identically on Windows dev machines and Linux CI runners.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
